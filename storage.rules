rules_version = '2';

// ============================================================
// !!! SECURITY RULES DIMATIKAN (DEVELOPMENT / SEMENTARA) !!!
// ------------------------------------------------------------
// Semua file Storage terbuka untuk SEMUA orang:
// baca, tulis, dan hapus tanpa perlu login.
//
// PERINGATAN: file sepenuhnya tidak terlindungi. Jangan dipakai di production.
// Rules asli ada di: storage.rules.bak
//
// Cara memulihkan:
//   cp storage.rules.bak storage.rules
//   firebase deploy --only storage
// ============================================================
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
