rules_version = '2';

// ============================================================
// !!! SECURITY RULES DIMATIKAN (DEVELOPMENT / SEMENTARA) !!!
// ------------------------------------------------------------
// Semua collection Firestore terbuka untuk SEMUA orang:
// baca, tulis, dan hapus tanpa perlu login.
//
// PERINGATAN: data sepenuhnya tidak terlindungi. Jangan dipakai di production.
// Rules asli ada di: firestore.rules.bak
//
// Cara memulihkan:
//   cp firestore.rules.bak firestore.rules
//   firebase deploy --only firestore:rules
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
