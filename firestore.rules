rules_version = '2';

// ============================================================
// Firestore Security Rules — Asrama IPB Sukasari (GABUNGAN web + app)
// ------------------------------------------------------------
// Satu project, satu ruleset. Mencakup collection /web (profil publik)
// DAN /app (internal penghuni).
//
// Definisi "admin" mencakup BOTH konvensi:
//   - users/<uid>.isAdmin == true           (konvensi /web)
//   - users/<uid>.jabatan in [ketua, wakil ketua, kepenghunian]  (konvensi /app)
//   - dokumen admins/<email>                 (fallback)
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        (userExists() && userData().isAdmin == true)
        || (userExists() && userData().jabatan in ["ketua", "wakil ketua", "kepenghunian"])
        || (request.auth.token.email != null
            && exists(/databases/$(database)/documents/admins/$(request.auth.token.email)))
      );
    }

    // ---------------- /web : konten profil publik ----------------
    match /berita/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /alumni/{id} {
      allow read: if resource.data.approved == true || isAdmin();
      allow create: if isAdmin()
        || (request.resource.data.approved == false
            && request.resource.data.source == "submission");
      allow update, delete: if isAdmin();
    }

    match /siteImages/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{id} {
      allow read: if isSignedIn() && (request.auth.token.email == id || isAdmin());
      allow write: if isAdmin();
    }

    // ---------------- users : dipakai web & app ----------------
    match /users/{id} {
      // Baca dokumen sendiri (cek isAdmin) atau admin baca semua.
      allow get: if isSignedIn()
        && (request.auth.uid == id || request.auth.token.email == id || isAdmin());
      // /app butuh daftar anggota (mis. verifikasi, daftar piket).
      allow list: if isSignedIn();
      // SignUp mandiri: anggota baru membuat dokumen sendiri.
      allow create: if isSignedIn() && request.auth.uid == id;
      allow update: if isSignedIn() && (request.auth.uid == id || isAdmin());
      allow delete: if isAdmin();
    }

    // ---------------- pendaftar OPREC (data pribadi) ----------------
    match /bakalCalonPenghuni/{id} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // ---------------- /app : collection internal (anggota login) ----------------
    match /piket/{id}        { allow read, write: if isSignedIn(); }
    match /jamal/{id}        { allow read, write: if isSignedIn(); }
    match /Spa/{id}          { allow read, write: if isSignedIn(); }
    match /absenMalam/{id}   { allow read, write: if isSignedIn(); }
    match /historyPoint/{id} { allow read, write: if isSignedIn(); }
    match /kegiatan/{id}     { allow read, write: if isSignedIn(); }
    match /catatanPiket/{id} { allow read, write: if isSignedIn(); }
    match /databaseSPS/{id}  { allow read, write: if isSignedIn(); }
    match /systemPoint/{id}  { allow read, write: if isSignedIn(); }

    // ---------------- AI rate-limit (hanya diakses Admin SDK) ----------------
    match /_aiRate/{id} {
      allow read, write: if false;
    }

    // Default: tolak.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
